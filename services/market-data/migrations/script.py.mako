# Rules for this project:
#   * Everything lives in the `market` schema: always write `market.<table>`.
#   * Prefer plain SQL via op.execute(...) for constraints, so the file reads
#     like the data dictionary.
#   * Every upgrade() needs a matching downgrade().
#   * Never edit a migration that has been applied elsewhere; add a new one.


def upgrade() -> None:
    """Upgrade schema."""
    ${upgrades if upgrades else "pass"}


def downgrade() -> None:
    """Downgrade schema."""
    ${downgrades if downgrades else "pass"}
