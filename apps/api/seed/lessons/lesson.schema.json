{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MarketLab lesson",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "position", "version", "title", "summary", "minutes", "steps", "questions"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60 },
    "position": { "type": "integer", "minimum": 1, "maximum": 12 },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 3, "maxLength": 80 },
    "summary": { "type": "string", "minLength": 10, "maxLength": 200 },
    "minutes": { "type": "integer", "minimum": 3, "maximum": 8 },
    "steps": {
      "type": "array", "minItems": 4, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["head", "body"],
        "properties": {
          "head": { "type": "string", "minLength": 2, "maxLength": 60 },
          "body": { "type": "string", "minLength": 10, "maxLength": 600 },
          "more": { "type": "string", "minLength": 10, "maxLength": 600 },
          "demo": { "enum": ["chance-70", "coin-streaks", "many-tries"] }
        }
      }
    },
    "questions": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["prompt", "options"],
        "properties": {
          "prompt": { "type": "string", "minLength": 5, "maxLength": 200 },
          "options": {
            "type": "array", "minItems": 2, "maxItems": 4,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["text", "why", "correct"],
              "properties": {
                "text": { "type": "string", "minLength": 1, "maxLength": 160 },
                "why": { "type": "string", "minLength": 10, "maxLength": 400 },
                "correct": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
