{
  "name": "marketlab-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../../docs/02-domain/openapi-gateway.json -o src/api/schema.d.ts",
    "check:api": "node scripts/check-api.mjs",
    "check:copy": "vitest run src/copy",
    "walk": "node scripts/walk.mjs",
    "a11y": "node scripts/a11y-audit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource-variable/raleway": "5.3.0",
    "lightweight-charts": "5.2.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-joyride": "3.2.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "27.4.0",
    "openapi-typescript": "7.13.0",
    "puppeteer-core": "24.43.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
