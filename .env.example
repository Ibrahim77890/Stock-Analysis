# Copy to .env (git-ignored) and adjust. Never commit real secrets.
# Native PostgreSQL service on localhost:5432. `uv run poe db-init` creates this role/database once.
POSTGRES_USER=marketlab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=marketlab

# Used by the Python service and Alembic (keep in sync with the values above).
DATABASE_URL=postgresql://marketlab:change-me@localhost:5432/marketlab

# Market-data provider keys (task 01_04). Leave empty until needed.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Sprint 05 (free keys; leave empty until needed; never commit real values).
# Tiingo: free account at https://www.tiingo.com/ -> Account -> API token. Free tier: 50 requests/hour,
# 1,000/day, 500 unique symbols/month, personal (internal) use only. Used for a long daily-price history.
TIINGO_API_KEY=
# FRED: free key, request it on the FRED API page https://fred.stlouisfed.org/docs/api/api_key.html (32-character string). Used for the
# risk-free rate (DGS3MO) and VIX (VIXCLS). Show the FRED attribution notice where the data are displayed.
FRED_API_KEY=


# Sprint 06: NestJS gateway and the internal link to the Python service.
# JWT_SECRET and INTERNAL_API_TOKEN are random values YOU generate on your machine (never commit real values):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
INTERNAL_API_TOKEN=
GATEWAY_PORT=3000
PYTHON_API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Sprint 07: Strategy Lab. Runs per minute and learner (optional; the default is 20).
LAB_RUNS_PER_MINUTE=20

# Opens GET /metrics on the gateway (separate from every learner token). Generate a random value on your machine; leave empty to keep /metrics closed.
OPERATOR_TOKEN=
