# Copy to .env (git-ignored) and adjust. Never commit real secrets.
# Native PostgreSQL service on localhost:5432. `uv run poe db-init` creates this role/database once.
POSTGRES_USER=marketlab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=marketlab

# Used by the Python service and Alembic (keep in sync with the values above).
DATABASE_URL=postgresql://marketlab:change-me@localhost:5432/marketlab

# Market-data provider keys (task 01_04). Leave empty until needed.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
